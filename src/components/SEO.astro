---
// SEO 组件：Title / Description / OG / Twitter Card / Canonical / JSON-LD
// 把所有 SEO 信息集中在这，方便全文统一

import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  breadcrumbs?: { name: string; href: string }[];
  siteSchema?: boolean; // 是否输出 Organization + WebSite（默认仅首页）
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  jsonLd,
  noindex = SITE.noindex,
  breadcrumbs,
  siteSchema = Astro.url.pathname === '/' || Astro.url.pathname === '',
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.authorGivenName} ${SITE.authorFamilyName}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = new URL(image, Astro.site).toString();

// ======== 全局 JSON-LD：Person ========
// Person schema：让 AI 知道这个站点的"主人"
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  givenName: SITE.authorGivenName,
  familyName: SITE.authorFamilyName,
  alternateName: SITE.authorAliases,
  url: SITE.url,
  jobTitle: 'AI Compliance Counsel · Agent Governance · BioAI',
  knowsAbout: [
    'AI Agent',
    'AI Governance',
    'Agent Compliance',
    'Large Language Model',
    'Prompt Engineering',
    'Agent Constitutional Self-Check',
    'AI Algorithm Filing',
    'Cross-border Data Compliance',
    'BioAI',
    'Clinical Evidence Evaluation',
    'OWASP Agentic Top 10',
    'A2A Protocol',
  ],
  sameAs: [
    'https://github.com/lawcontinue',
  ],
};

// ======== 首页：Organization + WebSite + SearchAction ========
// 让 AI 搜索引擎识别站点身份，并支持站内搜索建议
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.title,
  url: SITE.url,
  logo: new URL('/favicon.svg', Astro.site).toString(),
  founder: {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.author,
  },
  sameAs: [
    'https://github.com/lawcontinue',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
  },
  // SearchAction：搜索引擎能直接给用户建议
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// ======== 面包屑（可选） ========
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        item: new URL(crumb.href, Astro.site).toString(),
      })),
    }
  : null;

// ======== 装配所有 schema ========
const allSchemas: Record<string, unknown>[] = [personSchema];
if (siteSchema) {
  allSchemas.push(organizationSchema);
  allSchemas.push(websiteSchema);
}
if (breadcrumbSchema) {
  allSchemas.push(breadcrumbSchema);
}
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    allSchemas.push(...jsonLd);
  } else {
    allSchemas.push(jsonLd);
  }
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={`${SITE.authorGivenName} ${SITE.authorFamilyName}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{
  allSchemas.map((schema) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}