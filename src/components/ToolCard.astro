---
// 工具卡片：用于 tools 列表页
interface Props {
  title: string;
  slug: string;
  summary: string;
  category: string;
}
const { title, slug, summary, category } = Astro.props;
const categoryIcons: Record<string, string> = {
  calculator: '🧮',
  generator: '✨',
  checker: '🔎',
  visualizer: '📊',
};
---

<a class="tool-card" href={`/tools/${slug}`}>
  <span class="icon">{categoryIcons[category] || '🛠'}</span>
  <div>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    background: var(--bg-elev);
    color: var(--fg);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .tool-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  h3 {
    margin: 0 0 4px;
    font-size: 1.05rem;
  }
  .summary {
    color: var(--fg-soft);
    font-size: 0.92rem;
    margin: 0;
  }
</style>
