---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ToolCard from '../../components/ToolCard.astro';

const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title="Tools"
  description="可视化、可交互的 web 工具：计算器、生成器、可视化工具，全部在浏览器端运行。"
>
  <header class="head">
    <h1>Tools</h1>
    <p class="lede">
      在浏览器就能跑的小工具。每个工具都是真实可用的，不是壳页。
    </p>
  </header>

  <div class="grid">
    {tools.map((t) => (
      <ToolCard
        title={t.data.title}
        slug={t.id}
        summary={t.data.summary}
        category={t.data.category}
      />
    ))}
  </div>

  {tools.length === 0 && (
    <p class="empty">
      还没有工具。请到 <code>src/content/tools/</code> 下新增一个 <code>.md</code> 文件。
    </p>
  )}
</BaseLayout>

<style>
  .head { margin-bottom: 28px; }
  .lede { color: var(--fg-soft); margin: 0; }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .empty {
    color: var(--fg-mute);
    padding: 24px;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }
</style>
