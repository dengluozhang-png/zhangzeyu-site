---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);

const toolJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.data.title,
  description: tool.data.summary,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Modern browser with JavaScript enabled',
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: '张泽宇',
    url: 'https://zhangzeyu.me',
  },
  datePublished: tool.data.publishDate.toISOString(),
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={tool.data.title}
  description={tool.data.summary}
  jsonLd={toolJsonLd}
>
  <article class="tool">
    <header class="head">
      <p class="cat">Tool · {tool.data.category}</p>
      <h1>{tool.data.title}</h1>
      <p class="summary">{tool.data.summary}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <hr />
    <p class="back">← <a href="/tools">所有 Tools</a></p>
  </article>
</BaseLayout>

<style>
  .head { margin-bottom: 24px; }
  .cat {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  h1 { margin: 0 0 10px; }
  .summary { color: var(--fg-soft); font-size: 1.05rem; margin: 0; }
  .prose p, .prose ul { max-width: 720px; }
</style>
