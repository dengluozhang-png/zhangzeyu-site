---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · Not Found">
  <section class="notfound">
    <p class="code">404</p>
    <h1>页面不存在</h1>
    <p>这里没有你要找的东西。</p>
    <p><a href="/">回到首页 →</a></p>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: 60px 20px;
  }
  .code {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 4rem;
    margin: 0;
    font-weight: 700;
  }
  h1 { margin: 0 0 12px; }
</style>
