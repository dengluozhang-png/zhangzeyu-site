---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const writings = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// 按年份分组
const groups: Record<string, typeof writings> = {};
for (const w of writings) {
  const y = String(w.data.publishDate.getFullYear());
  if (!groups[y]) groups[y] = [];
  groups[y].push(w);
}
const years = Object.keys(groups).sort((a, b) => b.localeCompare(a));
---

<BaseLayout
  title="Writing"
  description="AI Agent、Agent 治理、BioAI、AI 合规相关笔记与读后感。"
>
  <header class="head">
    <h1>Writing</h1>
    <p class="lede">
      按年份倒序排列。文章可能是：读后感、案例研究、技术笔记、立场文章。
    </p>
  </header>

  {years.map((year) => (
    <section class="year">
      <h2>{year}</h2>
      <ul class="post-list">
        {groups[year].map((w) => (
          <li>
            <a href={`/writing/${w.id}`} class="post-link">
              <span class="title">{w.data.title}</span>
              <span class="meta">
                <time datetime={w.data.publishDate.toISOString()}>
                  {w.data.publishDate.toISOString().slice(5, 10)}
                </time>
                {w.data.tags.length > 0 && (
                  <span class="tags">
                    {w.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {writings.length === 0 && (
    <p class="empty">
      还没有文章。请到 <code>src/content/writing/</code> 下新增一个 <code>.md</code> 文件。
    </p>
  )}
</BaseLayout>

<style>
  .head { margin-bottom: 28px; }
  .lede { color: var(--fg-soft); margin: 0; }
  .year { margin-top: 32px; }
  .year h2 {
    font-size: 1rem;
    color: var(--fg-mute);
    border-bottom: 1px solid var(--border);
    padding-bottom: 6px;
    margin-top: 0;
  }
  .post-list { list-style: none; padding: 0; margin: 12px 0 0; }
  .post-list li { padding: 10px 0; border-bottom: 1px dashed var(--border); }
  .post-list li:last-child { border-bottom: 0; }
  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    color: var(--fg);
    border: 0;
  }
  .post-link:hover .title { color: var(--accent); }
  .title { font-size: 1rem; }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-mute);
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .tags { display: flex; gap: 6px; }
  .tag {
    background: var(--bg-soft);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.78rem;
  }
  .empty {
    color: var(--fg-mute);
    padding: 24px;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }
  @media (max-width: 640px) {
    .post-link { flex-direction: column; gap: 4px; }
  }
</style>
