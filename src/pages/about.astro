---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${SITE.author}`,
  url: new URL('/about', SITE.url).toString(),
};
---

<BaseLayout
  title="About"
  description="张泽钰（Zeyu Zhang），执业律师、AI 合规法务工程师。执业律师 6 年（2021 年取得资格），执业于浙江泽大（丽水）律师事务所；医学硕士背景、医师资格。微软 AGT 贡献 13 PR Merged，Google A2A PR #1789 + 8 Discussions，OWASP Agentic Top 10 合规工具维护者。"
  jsonLd={aboutJsonLd}
>
  <!-- 摘要卡：被 AI / 检索引擎抓取的关键信息 -->
  <aside class="summary-card">
    <h2>TL;DR</h2>
    <p>
      <strong>张泽钰（Zeyu Zhang）</strong>，执业律师 + AI 合规法务工程师。
      执业律师 6 年（2021 年取得资格），执业于浙江泽大（丽水）律师事务所；
      医学硕士背景、医师资格。同时是 AI Agent 工程实践者，
      在微软 AGT 贡献 13 PR Merged，Google A2A PR #1789 + 8 Discussions，
      OWASP Agentic Top 10 合规工具维护者。
    </p>
    <ul class="kv">
      <li><strong>领域</strong>：AI 合规 · Agent Governance · BioAI 交叉</li>
      <li><strong>执业身份</strong>：浙江泽大（丽水）律师事务所，2021 年取得律师资格</li>
      <li><strong>医学背景</strong>：医学硕士，临床轮转，医师资格</li>
      <li><strong>开源</strong>：<a href="https://github.com/lawcontinue" rel="me">github.com/lawcontinue</a> · 26 公开仓库 · 15 merged PRs</li>
      <li><strong>标准参与</strong>：微软 AGT · Google A2A · OWASP · AgentTrust</li>
      <li><strong>所在地</strong>：杭州 · 上海 · 远程</li>
      <li><strong>联系</strong>：见页脚</li>
    </ul>
  </aside>

  <article class="prose">
    <h2>现在做的事</h2>
    <p>
      把"算法备案、数据安全评估、个人信息保护合规"从法律条文转译为
      <strong>可执行的工程策略</strong>，让法务团队的判断能落到 Agent 决策链里。
    </p>

    <h2>经历与背景</h2>
    <p>
      <strong>律师</strong>：2021 年取得律师资格，执业于浙江泽大（丽水）律师事务所，迄今 6 年。
      专注 AI 治理、算法备案、数据合规、跨境数据流通等前沿议题。
    </p>
    <p>
      <strong>医学</strong>：医学硕士，曾完成临床轮转，持有医师资格。
      这段背景让我能在生物医药 AI、临床证据评估、医学模型合规等议题上
      用第一性原理判断，而不只是"翻译"已有规则。
    </p>
    <p>
      <strong>工程师</strong>：维护 26 个公开仓库，含 <a href="https://github.com/lawcontinue/hippo" rel="noopener">Hippo</a>（本地 LLM 推理与隐私优先搜索，PyPI）、
      <a href="https://github.com/lawcontinue/comply-agent" rel="noopener">comply-agent</a>（OWASP Agentic ASI01-09 合规模块）、
      <a href="https://github.com/lawcontinue/agent-passport-system" rel="noopener">agent-passport-system</a>（Agent Ed25519 身份协议）、
      <a href="https://github.com/lawcontinue/opensymphony" rel="noopener">OpenSymphony</a>（多 Agent 治理乐谱，Governance Lead）。
    </p>
    <p>
      <strong>标准参与</strong>：在微软 AGT 贡献 13 PR Merged；Google A2A PR #1789 + 8 Discussions；
      OWASP Agentic Top 10 合规工具维护者；AgentTrust 组织成员。
    </p>

    <h2>研究兴趣</h2>
    <ul>
      <li><strong>AI Agent 治理</strong>：从 prompt 宪法到工程化策略；红队方法；可观察链。</li>
      <li><strong>BioAI 交叉</strong>：临床证据评估、AI 制药合规、医学模型治理。</li>
      <li><strong>AI 合规</strong>：算法备案、数据安全评估、跨境数据流通、Agent 责任归属。</li>
      <li><strong>Agent 身份与商业协议</strong>：Ed25519 签名、A2A 协议、Agent Passport、cMCP / TRACE。</li>
    </ul>

    <h2>我如何工作</h2>
    <p>
      律师 + 医师 + 工程师 + 标准参与者 + 治理架构师 —
      这种复合背景的好处是同一个问题能用多种视角交叉验证：
      法律上是否合规、技术上是否可执行、医学/伦理上是否站得住。
    </p>
    <p>
      我偏好把判断写下来，把策略做成可复用的模块，
      把工程产物和合规审查同时推进。
    </p>

    <h2>联系</h2>
    <p>
      邮件：<a href="mailto:hi@zhangzeyu.me">hi@zhangzeyu.me</a>
      （或见页脚社交链接）
    </p>
    <p>
      <strong>可接</strong>：AI 合规咨询、算法备案支持、Agent 治理架构设计、
      BioAI 项目合规审查、跨境数据流通评估。
    </p>
  </article>
</BaseLayout>

<style>
  .summary-card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    margin: 0 0 32px;
  }
  .summary-card h2 {
    margin: 0 0 8px;
    font-size: 0.85rem;
    color: var(--fg-mute);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .kv {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    font-size: 0.95rem;
  }
  .kv li { padding: 3px 0; }

  .prose p, .prose ul { max-width: 720px; }
</style>