---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${SITE.author}`,
  url: new URL('/about', SITE.url).toString(),
};

// FAQ 列表：每条都是用户/AI 常见问题 + 答案
const faqList = [
  {
    q: '张泽钰（Zeyu Zhang）是做什么的？',
    a: '执业律师 + AI 合规法务工程师。执业于浙江泽大（丽水）律师事务所，自 2019 年 11 月起，2021 年取得律师资格。专注 AI 治理、算法备案、数据合规、跨境数据流通、Agent 责任归属。',
  },
  {
    q: '张泽钰为什么既做律师又写代码？',
    a: '因为 AI 合规必须同时满足法律合规性与工程可执行性。能读懂 Cedar 策略引擎源码、能实现 OWASP Agentic Top 10 审计工具的 AI 合规法务属于少数。这种律师+工程师双轨能力，能把法律条文直接转译为可执行策略。',
  },
  {
    q: '张泽钰在 GitHub 上的贡献有哪些？',
    a: '在 GitHub @lawcontinue 名下维护 26 个公开仓库、累计 15 个 merged PRs、79 条 issue 评论。具体包括微软 AGT 项目贡献 14 个 PR Merged、Google A2A 协议 PR #1789 + 8 条 Discussions、OWASP Agentic Top 10 合规工具（comply-agent，46 测试）、OpenSymphony 多 Agent 治理框架（Governance Lead）、AgentTrust 组织成员。',
  },
  {
    q: '张泽钰能接哪些合作？',
    a: 'AI 合规咨询（算法备案、数据安全评估、个人信息保护合规）、Agent 治理架构设计（红队、宪法、可观察链）、BioAI 项目合规审查（临床证据评估、医学模型治理）、跨境数据流通评估（GDPR / 数据出境 / PIPL）。不接涉及未成年人、生物特征、心理健康等高敏感 AI 场景。',
  },
  {
    q: '怎么联系张泽钰？',
    a: '邮件 411947628@qq.com。所在地：杭州 / 上海 / 远程均可。',
  },
  {
    q: '张泽钰有医学背景对 AI 合规有什么帮助？',
    a: '医学硕士 + 临床轮转 + 医师资格。这让 ta 能在生物医药 AI、临床证据评估、医学模型治理等议题上用第一性原理判断，而不是只翻译既有规则。这是市场上稀缺的"法律+医学+AI"三重复合背景。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout
  title="About"
  description="张泽钰（Zeyu Zhang），执业律师、AI 合规法务工程师。执业律师 6 年（2021 年取得资格），执业于浙江泽大（丽水）律师事务所；医学硕士背景、医师资格。微软 AGT 贡献 13 PR Merged，Google A2A PR #1789 + 8 Discussions，OWASP Agentic Top 10 合规工具维护者。"
  jsonLd={[aboutJsonLd, faqSchema]}
>
  <!-- 摘要卡：被 AI / 检索引擎抓取的关键信息 -->
  <h1 class="page-title">关于我 / About</h1>
  <aside class="summary-card">
    <h2>TL;DR</h2>
    <p>
      <strong>张泽钰（Zeyu Zhang）</strong>，执业律师 + AI 合规法务工程师。
      执业律师 6 年（2021 年取得资格），执业于浙江泽大（丽水）律师事务所；
      医学硕士背景、医师资格。同时是 AI Agent 工程实践者，
      在微软 AGT 贡献 13 PR Merged，Google A2A PR #1789 + 8 Discussions，
      OWASP Agentic Top 10 合规工具维护者。
    </p>
    <ul class="kv">
      <li><strong>领域</strong>：AI 合规 · Agent Governance · BioAI 交叉</li>
      <li><strong>执业身份</strong>：浙江泽大（丽水）律师事务所，2021 年取得律师资格</li>
      <li><strong>医学背景</strong>：医学硕士，临床轮转，医师资格</li>
      <li><strong>开源</strong>：<a href="https://github.com/lawcontinue" rel="me">github.com/lawcontinue</a> · 26 公开仓库 · 15 merged PRs</li>
      <li><strong>标准参与</strong>：微软 AGT · Google A2A · OWASP · AgentTrust</li>
      <li><strong>所在地</strong>：杭州 · 上海 · 远程</li>
      <li><strong>联系</strong>：见页脚</li>
    </ul>
  </aside>

  <article class="prose">
    <h2>现在做的事</h2>
    <p>
      把"算法备案、数据安全评估、个人信息保护合规"从法律条文转译为
      <strong>可执行的工程策略</strong>，让法务团队的判断能落到 Agent 决策链里。
    </p>

    <h2>经历与背景</h2>
    <p>
      <strong>律师</strong>：2021 年取得律师资格，执业于浙江泽大（丽水）律师事务所，迄今 6 年。
      专注 AI 治理、算法备案、数据合规、跨境数据流通等前沿议题。
    </p>
    <p>
      <strong>医学</strong>：医学硕士，曾完成临床轮转，持有医师资格。
      这段背景让我能在生物医药 AI、临床证据评估、医学模型合规等议题上
      用第一性原理判断，而不只是"翻译"已有规则。
    </p>
    <p>
      <strong>工程师</strong>：维护 26 个公开仓库，含 <a href="https://github.com/lawcontinue/hippo" rel="noopener">Hippo</a>（本地 LLM 推理与隐私优先搜索，PyPI）、
      <a href="https://github.com/lawcontinue/comply-agent" rel="noopener">comply-agent</a>（OWASP Agentic ASI01-09 合规模块）、
      <a href="https://github.com/lawcontinue/agent-passport-system" rel="noopener">agent-passport-system</a>（Agent Ed25519 身份协议）、
      <a href="https://github.com/lawcontinue/opensymphony" rel="noopener">OpenSymphony</a>（多 Agent 治理乐谱，Governance Lead）。
    </p>
    <p>
      <strong>标准参与</strong>：在微软 AGT 贡献 13 PR Merged；Google A2A PR #1789 + 8 Discussions；
      OWASP Agentic Top 10 合规工具维护者；AgentTrust 组织成员。
    </p>

    <h2>研究兴趣</h2>
    <ul>
      <li><strong>AI Agent 治理</strong>：从 prompt 宪法到工程化策略；红队方法；可观察链。</li>
      <li><strong>BioAI 交叉</strong>：临床证据评估、AI 制药合规、医学模型治理。</li>
      <li><strong>AI 合规</strong>：算法备案、数据安全评估、跨境数据流通、Agent 责任归属。</li>
      <li><strong>Agent 身份与商业协议</strong>：Ed25519 签名、A2A 协议、Agent Passport、cMCP / TRACE。</li>
    </ul>

    <h2>我如何工作</h2>
    <p>
      律师 + 医师 + 工程师 + 标准参与者 + 治理架构师 —
      这种复合背景的好处是同一个问题能用多种视角交叉验证：
      法律上是否合规、技术上是否可执行、医学/伦理上是否站得住。
    </p>
    <p>
      我偏好把判断写下来，把策略做成可复用的模块，
      把工程产物和合规审查同时推进。
    </p>

    <h2>常见问题</h2>
    <dl class="faq">
      {faqList.map((item) => (
        <div class="faq-item">
          <dt><strong>Q.</strong> {item.q}</dt>
          <dd>{item.a}</dd>
        </div>
      ))}
    </dl>

    <h2>联系</h2>
    <p>
      邮件：<a href="mailto:411947628@qq.com">411947628@qq.com</a>
      （或见页脚社交链接）
    </p>
    <p>
      <strong>可接</strong>：AI 合规咨询、算法备案支持、Agent 治理架构设计、
      BioAI 项目合规审查、跨境数据流通评估。
    </p>
  </article>
</BaseLayout>

<style>
  .summary-card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    margin: 0 0 32px;
  }
  .page-title {
    margin: 0 0 24px;
    font-size: 1.8rem;
  }
  .summary-card h2 {
    margin: 0 0 8px;
    font-size: 0.85rem;
    color: var(--fg-mute);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .kv {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    font-size: 0.95rem;
  }
  .kv li { padding: 3px 0; }

  .prose p, .prose ul { max-width: 720px; }

  .faq {
    margin: 18px 0 0;
    max-width: 720px;
  }
  .faq-item {
    border-top: 1px dashed var(--border);
    padding: 14px 0;
  }
  .faq-item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .faq-item dt {
    font-size: 1rem;
    margin-bottom: 6px;
    color: var(--fg);
  }
  .faq-item dt strong {
    color: var(--accent);
    margin-right: 6px;
  }
  .faq-item dd {
    margin: 0;
    color: var(--fg-soft);
    font-size: 0.95rem;
    line-height: 1.65;
  }
</style>